<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PictureQsMaui.PicturesPage"
             Title="Pictures">

    <Grid Padding="16"
          RowDefinitions="*,Auto"
          RowSpacing="12">
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Pictures}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="10"
                            Stroke="#D0D0D0">
                        <Grid ColumnDefinitions="Auto,64,*,160,Auto"
                              ColumnSpacing="10">
                            <RadioButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         VerticalOptions="Center" />
                            <Image Grid.Column="1"
                                   Source="{Binding ThumbnailSource}"
                                   WidthRequest="64"
                                   HeightRequest="48"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text="{Binding PictureName}"
                                   VerticalOptions="Center" />
                            <Entry Grid.Column="3"
                                   Text="{Binding TargetsFileName, Mode=TwoWay}"
                                   Placeholder="Targets name (no .json)"
                                   VerticalOptions="Center"
                                   ClearButtonVisibility="WhileEditing" />
                            <Button Grid.Column="4"
                                    Text="Edit"
                                    Clicked="OnEditPictureNamesClicked" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid x:Name="FooterLayout"
              Grid.Row="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="24"
              SizeChanged="OnFooterSizeChanged">
            <HorizontalStackLayout Spacing="8"
                                   VerticalOptions="Center">
                <Button x:Name="AddPictureButton"
                        Text="Add picture"
                        Clicked="OnAddPictureClicked" />
                <Button x:Name="BackupButton"
                        Text="Backup"
                        Clicked="OnBackupClicked" />
                <Button x:Name="RestoreButton"
                        Text="Restore"
                        Clicked="OnRestoreClicked" />
            </HorizontalStackLayout>

            <HorizontalStackLayout x:Name="DialogActions"
                                   Grid.Column="1"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   Spacing="8">
                <Button Text="Cancel"
                        Clicked="OnCancelClicked" />
                <Button Text="OK"
                        Clicked="OnOkClicked" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
