<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PictureQsMaui.PicturesPage"
             Title="Pictures">

    <Grid Padding="16"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="12">
        <Button Text="Choose picture from gallery"
                Clicked="OnAddPictureClicked" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Pictures}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="10"
                            Stroke="#D0D0D0">
                        <Grid ColumnDefinitions="*,160,Auto"
                              ColumnSpacing="10">
                            <RadioButton Content="{Binding PictureFileName}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Text="{Binding TargetsFileName, Mode=TwoWay}"
                                   Placeholder="Targets name (no .json)"
                                   VerticalOptions="Center"
                                   ClearButtonVisibility="WhileEditing" />
                            <Button Grid.Column="2"
                                    Text="Delete"
                                    TextColor="DarkRed"
                                    Clicked="OnDeletePictureClicked" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="2"
                               HorizontalOptions="End"
                               Spacing="8">
            <Button Text="Cancel"
                    Clicked="OnCancelClicked" />
            <Button Text="OK"
                    Clicked="OnOkClicked" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
