<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PictureQsMaui.SkeletonPage"
             x:Name="PageRoot"
             Shell.NavBarIsVisible="False"
             Title="Skeleton">

    <Grid Padding="12"
          ColumnDefinitions="*,260"
          ColumnSpacing="12">
        <Grid Grid.Column="0"
              RowDefinitions="Auto,*"
              RowSpacing="8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                  ColumnSpacing="8">
                <Button Text="−"
                        WidthRequest="48"
                        Clicked="OnZoomOutClicked" />
                <Button Grid.Column="1"
                        Text="+"
                        WidthRequest="48"
                        Clicked="OnZoomInClicked" />
                <Button Grid.Column="2"
                        Text="Reset view"
                        Clicked="OnResetViewClicked" />
                <Label Grid.Column="3"
                       Text="Drag to rotate · two-finger drag to move · pinch or use +/− to zoom · tap a bone"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="End"
                       LineBreakMode="WordWrap" />
            </Grid>

            <Border Grid.Row="1"
                    Stroke="#D0D0D0"
                    StrokeThickness="1"
                    Padding="6">
                <Grid x:Name="SkeletonViewport"
                      BackgroundColor="#101820">
                    <WebView x:Name="SkeletonWebView"
                             Navigating="OnSkeletonWebViewNavigating" />
                    <Label x:Name="LoadingLabel"
                           Text="Loading skeleton..."
                           TextColor="White"
                           BackgroundColor="#C0101820"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Padding="16"
                           InputTransparent="True" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*,Auto"
              RowSpacing="8">
            <Label Text="Points of interest"
                   FontAttributes="Bold"
                   FontSize="18" />

            <CollectionView Grid.Row="1"
                            x:Name="PoiListView"
                            SelectionMode="Single"
                            SelectionChanged="OnPoiSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="Delete"
                                               BackgroundColor="DarkRed"
                                               Command="{Binding Source={x:Reference PageRoot}, Path=DeletePoiCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Grid Padding="12,10">
                                <Label Text="{Binding Text}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid Grid.Row="2"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Button x:Name="ViewModeButton"
                            Text="Quiz Mode"
                            Clicked="OnViewClicked" />
                    <Button Grid.Column="1"
                            x:Name="RandomButton"
                            Text="Random"
                            IsVisible="False"
                            Clicked="OnRandomClicked" />
                </Grid>
                <Button Grid.Row="1"
                        Text="Pictures"
                        Clicked="OnPicturesClicked" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
