<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PictureQsMaui.PictureNamePage"
             Title="Picture names">

    <VerticalStackLayout Padding="20"
                         Spacing="12"
                         VerticalOptions="Center">
        <Image x:Name="PicturePreview"
               Aspect="AspectFit"
               HeightRequest="220" />
        <Label Text="Picture name"
               FontAttributes="Bold" />
        <Entry x:Name="PictureNameEntry"
               Placeholder="Name (without file extension)"
               ClearButtonVisibility="WhileEditing" />

        <Label Text="JSON file name"
               FontAttributes="Bold" />
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
            <Entry x:Name="TargetsFileNameEntry"
                   Placeholder="Name (without .json)"
                   ClearButtonVisibility="WhileEditing" />
            <Button Grid.Column="1"
                    Text="Sync"
                    Clicked="OnSyncClicked" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
            <Button x:Name="DeletePictureButton"
                    Text="Delete Picture"
                    TextColor="DarkRed"
                    HorizontalOptions="Start"
                    Clicked="OnDeletePictureClicked" />
            <HorizontalStackLayout Grid.Column="1"
                                   HorizontalOptions="End"
                                   Spacing="8">
                <Button Text="Cancel"
                        Clicked="OnCancelClicked" />
                <Button Text="Accept"
                        Clicked="OnAcceptClicked" />
            </HorizontalStackLayout>
        </Grid>
    </VerticalStackLayout>
</ContentPage>
