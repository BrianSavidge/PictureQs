<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PictureQsMaui.MainPage"
             x:Name="PageRoot"
             Shell.NavBarIsVisible="False"
             Title="PictureQs">

    <Grid Padding="12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0"
              RowDefinitions="Auto,*"
              RowSpacing="8">
            <Border Grid.Row="1"
                    Stroke="#D0D0D0"
                    StrokeThickness="1"
                    Padding="6">
                <Grid x:Name="PictureViewport"
                      BackgroundColor="Black">
                    <Image x:Name="PictureImage"
                           Aspect="AspectFit"
                           BackgroundColor="Black"
                           Scale="1"
                           AnchorX="0.5"
                           AnchorY="0.5"
                           SizeChanged="OnPictureSizeChanged" />

                    <GraphicsView x:Name="MarkerOverlay"
                                  InputTransparent="True"
                                  Scale="1"
                                  AnchorX="0.5"
                                  AnchorY="0.5" />

                    <Grid x:Name="GestureSurface"
                          BackgroundColor="Transparent">
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1">
            <Grid x:Name="PoiListPanel"
                  RowDefinitions="Auto,*,Auto"
                  RowSpacing="8">
                <Label Text="Points of interest"
                       FontAttributes="Bold"
                       FontSize="18" />

                <CollectionView Grid.Row="1"
                                x:Name="PoiListView"
                                SelectionMode="Single"
                                SelectionChanged="OnPoiSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItem Text="Edit"
                                                   BackgroundColor="DarkSlateBlue"
                                                   Command="{Binding Source={x:Reference PageRoot}, Path=EditPoiCommand}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Grid Padding="12,10">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer NumberOfTapsRequired="2"
                                                              Tapped="OnPoiDoubleTapped" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="{Binding Text}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid Grid.Row="2"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="8">
                    <Grid x:Name="ViewModeControls"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Button x:Name="ViewModeButton"
                                Text="Quiz Mode"
                                Clicked="OnViewClicked" />
                        <Button Grid.Column="1"
                                x:Name="RandomButton"
                                Text="Random"
                                IsVisible="False"
                                Clicked="OnRandomClicked" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <Button x:Name="PicturesButton"
                                Text="Pictures"
                                Clicked="OnPicturesClicked" />
                    </Grid>
                </Grid>

            </Grid>

            <Grid x:Name="PoiEditPanel"
                  IsVisible="False"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
                  RowSpacing="12">
                <Label Text="Point of interest"
                       FontAttributes="Bold"
                       FontSize="18" />
                <Label x:Name="EditingPoiNameLabel"
                       Grid.Row="1"
                       FontSize="16"
                       LineBreakMode="WordWrap" />
                <VerticalStackLayout x:Name="PoiStandardActions"
                                     Grid.Row="2"
                                     Spacing="8">
                    <Button Text="Rename"
                            Clicked="OnRenamePoiClicked" />
                    <Button Text="Choose new location"
                            Clicked="OnChoosePoiLocationClicked" />
                    <Button Text="Edit lines and areas"
                            Clicked="OnDrawShapeClicked" />
                    <Button Text="Delete point of interest"
                            TextColor="White"
                            BackgroundColor="DarkRed"
                            Clicked="OnEditDeletePoiClicked" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="ShapeEditingActions"
                                     Grid.Row="3"
                                     IsVisible="False"
                                     Spacing="8">
                    <VerticalStackLayout Spacing="8">
                        <Button x:Name="EndLineButton"
                                Text="End line"
                                Clicked="OnEndLineClicked" />
                        <Button x:Name="CompleteAreaButton"
                                Text="Complete area"
                                Clicked="OnCompleteAreaClicked" />
                        <Button
                                Text="Clear points"
                                Clicked="OnClearPendingPoiShapePointsClicked" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <Label x:Name="LocationStatusLabel"
                       Grid.Row="4"
                       IsVisible="False"
                       TextColor="Gray" />
                <Button x:Name="ReturnToPoiListButton"
                        Grid.Row="5"
                        VerticalOptions="End"
                        Text="Return to points of interest"
                        Clicked="OnReturnToPoiListClicked" />
                <VerticalStackLayout x:Name="ShapeEditingFooter"
                                     Grid.Row="5"
                                     IsVisible="False"
                                     VerticalOptions="End"
                                     Spacing="8">
                    <Button x:Name="DeletePoiShapeButton"
                            Text="Delete a line or area"
                            Clicked="OnDeletePoiShapeClicked" />
                    <Button Text="Clear all lines and areas"
                            Clicked="OnClearAllPoiShapesClicked" />
                    <Button Text="Finished editing lines and areas"
                            Clicked="OnFinishShapeEditingClicked" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <Grid x:Name="DeleteShapeConfirmationOverlay"
              Grid.ColumnSpan="2"
              IsVisible="False"
              BackgroundColor="#66000000">
            <Border Margin="12"
                    Padding="16"
                    VerticalOptions="End"
                    BackgroundColor="White"
                    Stroke="#D0D0D0">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="DeleteShapeConfirmationMessage"
                           FontSize="16"
                           TextColor="Black" />
                    <HorizontalStackLayout Spacing="8"
                                           HorizontalOptions="End">
                        <Button Text="Keep"
                                Clicked="OnKeepPoiShapeClicked" />
                        <Button Text="Delete"
                                TextColor="White"
                                BackgroundColor="DarkRed"
                                Clicked="OnConfirmDeletePoiShapeClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
